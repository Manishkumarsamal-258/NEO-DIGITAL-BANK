# ── NeoBank Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.

# API Base URL — the backend API server address
# - Development: Vite proxy handles /api → localhost:8080, so leave empty
# - Production:  set to your deployed backend URL (e.g. https://api.neobank.com)
VITE_API_BASE_URL=

# Application settings
VITE_APP_TITLE=NeoBank — Digital Banking Platform
VITE_APP_URL=https://www.neobank.com

# Optional: Analytics / Monitoring
# VITE_ANALYTICS_ID=

# Optional: Feature flags
# VITE_ENABLE_CHAT_SUPPORT=false
