# ── Heroku Procfile ────────────────────────────────────────
# For deploying the frontend as a static site on Heroku.
# Requires the Heroku static buildpack:
#   heroku buildpacks:set heroku-community/static
#
# The buildpack automatically serves the site from 'static.json' config.
# No `web` command is needed — the buildpack handles serving.
